# =============================================================================
# Django core settings
# =============================================================================
SECRET_KEY=replace-with-a-random-local-development-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# =============================================================================
# Database engine selection
# =============================================================================
# Set to True to use PostgreSQL (production). False/omitted uses SQLite (local dev).
USE_POSTGRESQL=False

# =============================================================================
# SQLite settings (used when USE_POSTGRESQL=False)
# =============================================================================
SQLITE_DB_NAME=db.sqlite3

# =============================================================================
# PostgreSQL settings (used when USE_POSTGRESQL=True)
# Railway provides these via the PostgreSQL service connection info.
# Do NOT put secrets in DATABASE_URL — use individual fields instead.
# =============================================================================
POSTGRES_DB=railway
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-your-postgres-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer

# =============================================================================
# CORS / CSRF origins — set these to your Railway frontend domain in production
# =============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# =============================================================================
# Security (harden these before going live)
# =============================================================================
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SECURE_PROXY_SSL_HEADER=
X_FRAME_OPTIONS=DENY
SECURE_REFERRER_POLICY=same-origin
LOG_LEVEL=INFO

# =============================================================================
# Production example values (uncomment and customize for Render deployment):
# Render provides the PostgreSQL connection details on the database page;
# set POSTGRES_DB, POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_HOST and
# POSTGRES_PORT from there (or link them via render.yaml).
# =============================================================================
# DEBUG=False
# ALLOWED_HOSTS=your-app.onrender.com,your-custom-domain.com
# CORS_ALLOWED_ORIGINS=https://your-frontend.onrender.com
# CSRF_TRUSTED_ORIGINS=https://your-frontend.onrender.com
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
# SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
# DATABASE_URL=postgresql://postgres:password@host:5432/dbname