# Vite frontend environment variables
# These are baked into the build at compile time by Vite.
# Only variables prefixed with VITE_ are exposed to the frontend code.

# In production on Railway (single service serving both frontend and API),
# leave this unset. The API client uses window.location.origin, so API calls
# go to the same host automatically.

# For local development with a separate backend:
VITE_API_URL=http://127.0.0.1:8000

# For production with separate frontend/backend services:
# VITE_API_URL=https://your-backend-service.up.railway.app